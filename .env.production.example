ENVIRONMENT=production

# Keep these credentials synchronized with the URLs below. Use unique secrets.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-long-postgres-password@postgres:5432/rag

REDIS_PASSWORD=replace-with-a-long-redis-password
CELERY_BROKER_URL=redis://:replace-with-a-long-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-long-redis-password@redis:6379/1
QUESTION_CACHE_REDIS_URL=redis://:replace-with-a-long-redis-password@redis:6379/2
QUERY_CONCURRENCY_REDIS_URL=redis://:replace-with-a-long-redis-password@redis:6379/3

STORAGE_ACCESS_KEY=replace-with-a-unique-minio-access-key
STORAGE_SECRET_KEY=replace-with-a-long-minio-secret-key
STORAGE_BUCKET=documents
STORAGE_ENDPOINT_URL=http://minio:9000
QDRANT_URL=http://qdrant:6333

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=https://app.example.com

# Tune these for the deployment size.
WEB_CONCURRENCY=2
CELERY_WORKER_CONCURRENCY=2
