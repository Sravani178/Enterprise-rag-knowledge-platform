ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=http://localhost:5173
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_SOFT_TIME_LIMIT_SECONDS=600
CELERY_TIME_LIMIT_SECONDS=660
CELERY_MAX_RETRIES=3
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=documents
STORAGE_REGION=us-east-1
STORAGE_CONNECT_TIMEOUT_SECONDS=5
STORAGE_READ_TIMEOUT_SECONDS=30
STORAGE_ORPHAN_GRACE_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=26214400
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks_openai_1536
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEMANTIC_CHUNKING_ENABLED=true
SEMANTIC_CHUNK_SIMILARITY_THRESHOLD=0.78
SEMANTIC_CHUNK_MIN_SIZE=200
VECTOR_CANDIDATE_K=20
BM25_CANDIDATE_K=20
RRF_K=60
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=512
RERANKER_MAX_TEXT_CHARS=4000
RERANKER_BATCH_SIZE=16
RERANKER_MAX_CONCURRENCY=2
RERANKER_TIMEOUT_SECONDS=10
RERANKER_FALLBACK_PROVIDER=lexical
RERANKER_CANDIDATE_K=20
MIN_RETRIEVAL_SCORE=0.05
PROCESSING_STALE_AFTER_SECONDS=900
AUTH_REQUIRED=false
JWT_SECRET=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Required for OpenAI embeddings and answer generation.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=0.5
QUERY_UNDERSTANDING_ENABLED=true
QUERY_UNDERSTANDING_MAX_TOKENS=200
ANSWER_EVALUATION_ENABLED=true
ANSWER_EVALUATION_MAX_ATTEMPTS=2
ANSWER_EVALUATION_MIN_SCORE=0.75
QUESTION_CACHE_ENABLED=true
QUESTION_CACHE_REDIS_URL=redis://localhost:6379/2
QUESTION_CACHE_TTL_SECONDS=86400
QUESTION_CACHE_SIMILARITY_THRESHOLD=0.94
QUESTION_CACHE_MAX_CANDIDATES=50
QUESTION_CACHE_LOCK_SECONDS=45
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_SECONDS=2
CELERY_BROKER_POOL_LIMIT=20
QUERY_CONCURRENCY_LIMIT=100
QUERY_CONCURRENCY_WAIT_SECONDS=10
QUERY_CONCURRENCY_DISTRIBUTED_ENABLED=true
QUERY_CONCURRENCY_REDIS_URL=redis://localhost:6379/3
QUERY_CONCURRENCY_LEASE_SECONDS=120
